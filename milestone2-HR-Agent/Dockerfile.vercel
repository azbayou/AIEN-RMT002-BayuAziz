FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    BACKEND_ONLY=true \
    REDIS_URL="" \
    PORT=80

WORKDIR /app

COPY api/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY data/ ./data/

EXPOSE 80
CMD ["sh", "-c", "uvicorn src.api:create_app --factory --host 0.0.0.0 --port ${PORT:-80}"]
