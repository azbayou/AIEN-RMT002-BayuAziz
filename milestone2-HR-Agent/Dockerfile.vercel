FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    BACKEND_ONLY=true \
    PORT=80

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends redis-server \
    && rm -rf /var/lib/apt/lists/*

COPY api/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY data/ ./data/

EXPOSE 80
CMD ["sh", "-c", "if [ -z \"${REDIS_URL:-}\" ]; then redis-server --daemonize yes --bind 127.0.0.1 --port 6379 --save '' --appendonly no && export REDIS_URL=redis://127.0.0.1:6379/0; fi && exec uvicorn src.api:create_app --factory --host 0.0.0.0 --port \"${PORT:-80}\""]
