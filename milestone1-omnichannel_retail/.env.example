ANALYTICS_DB_TARGET=neon

# Preferred explicit profile URLs.
NEON_DATABASE_URL=
LOCAL_DATABASE_URL=postgresql://retail:retail@localhost:5432/retail_analytics

# Backward-compatible Neon connection fields used by the existing .env file.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=retail_analytics
POSTGRES_USER=retail
POSTGRES_PASSWORD=retail
POSTGRES_SSLMODE=require
NL2SQL_PROVIDER=mock
OPENAI_API_KEY=
